{
  "name": "dear-child-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ילדי היקר (Yaldi HaYakar) — שרת REST API, MCP וצינור נתונים (הסדנא לידע ציבורי)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed-dictionaries.js",
    "etl:sync": "node dist/etl/run-sync.js",
    "admin:corrections": "node dist/cli/manage-corrections.js",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
