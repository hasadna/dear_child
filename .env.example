# ==============================================================================
# .env.example — משתני סביבה לפרויקט "ילדי היקר" (hasadna/dear_child)
# בסביבת Production ב-hasadna-k8s הסודות מוזרקים מ-Vault (vault:path:key)
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
ACTIVE_SCHOOL_YEAR=2027

# חיבורי מסד הנתונים (PostgreSQL 17 + PostGIS 3.4 + pg_trgm)
# בהפרדת Roles לפי docs/04_data_schema_v1.md:
DATABASE_PUBLIC_RO_URL=postgresql://app_public_ro:password@localhost:5432/dear_child
DATABASE_BACKEND_WRITE_URL=postgresql://app_backend_write:password@localhost:5432/dear_child
DATABASE_ETL_URL=postgresql://app_etl:password@localhost:5432/dear_child

# מפתחות HMAC-SHA256 ו-HKDF סודיים ונפרדים (שמורים ב-Vault — לעולם לא ב-DB! - D-34, D-38)
SECRET_PEPPER=replace-with-256-bit-random-secret-from-vault
QUOTA_PEPPER_SEPARATE=replace-with-separate-256-bit-random-secret-from-vault

# אימות Google OIDC (Scope: openid בלבד ללא email! - D-29) ו-Cloudflare Turnstile
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# מקורות סנכרון חיצוניים לצינור הנתונים (ETL)
EXTERNAL_FACILITIES_API_URL=https://api-m5crpfzdeq-ez.a.run.app
EXTERNAL_FACILITIES_CSV_URL=https://next.obudget.org/datapackages/facilities/all/facilities.csv
OBUDGET_FACILITIES_URL=https://next.obudget.org/datapackages/facilities/all/facilities.csv
